{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/itmo/frontend-consumed.schema.json",
  "title": "ProgramDatabase fields consumed by the current frontend",
  "type": "object",
  "required": ["program", "careers", "skills", "disciplines", "elective_groups", "timeline", "career_actions", "career_center", "game_events", "career_routes", "disclaimer"],
  "properties": {
    "program": {
      "type": "object",
      "required": ["program_name", "direction_code", "direction_name"],
      "properties": {
        "program_name": { "type": "string", "minLength": 1 },
        "direction_code": { "type": "string" },
        "direction_name": { "type": "string" }
      },
      "additionalProperties": true
    },
    "careers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/career" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "disciplines": { "type": "array", "items": { "$ref": "#/$defs/discipline" } },
    "elective_groups": { "type": "array", "items": { "$ref": "#/$defs/electiveGroup" } },
    "timeline": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/timelineSemester" } },
    "career_actions": { "type": "array", "items": { "$ref": "#/$defs/careerAction" } },
    "career_center": {
      "type": "object",
      "required": ["resources"],
      "properties": { "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } } },
      "additionalProperties": true
    },
    "game_events": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/gameEvent" } },
    "career_routes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/careerRoute" } },
    "disclaimer": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string" } },
    "career": {
      "type": "object",
      "required": ["career_id", "title", "short_description", "what_you_do", "key_skills", "specializations", "why_this_program", "entry_level_examples"],
      "properties": {
        "career_id": { "type": "string" },
        "title": { "type": "string" },
        "short_description": { "type": "string" },
        "what_you_do": { "$ref": "#/$defs/stringArray" },
        "key_skills": { "$ref": "#/$defs/stringArray" },
        "specializations": { "$ref": "#/$defs/stringArray" },
        "why_this_program": { "type": "string" },
        "entry_level_examples": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": true
    },
    "skill": {
      "type": "object",
      "required": ["skill_id", "title"],
      "properties": { "skill_id": { "type": "string" }, "title": { "type": "string" } },
      "additionalProperties": true
    },
    "discipline": {
      "type": "object",
      "required": ["discipline_id", "name", "credits"],
      "properties": {
        "discipline_id": { "type": "string" },
        "name": { "type": "string" },
        "credits": { "type": "number" },
        "simple_description": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "electiveOption": {
      "type": "object",
      "required": ["discipline_id", "skills", "career_fit"],
      "properties": {
        "discipline_id": { "type": "string" },
        "simple_description": { "type": ["string", "null"] },
        "skills": { "$ref": "#/$defs/stringArray" },
        "career_fit": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      },
      "additionalProperties": true
    },
    "electiveGroup": {
      "type": "object",
      "required": ["group_id", "name", "semesters", "selection_mode", "required_count", "required_credits", "child_group_ids", "options"],
      "properties": {
        "group_id": { "type": "string" },
        "name": { "type": "string" },
        "semesters": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 8 } },
        "selection_mode": { "enum": ["all", "choose_n_disciplines", "choose_n_groups", "choose_credits"] },
        "required_count": { "type": ["integer", "null"] },
        "required_credits": { "type": ["number", "null"] },
        "child_group_ids": { "$ref": "#/$defs/stringArray" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/electiveOption" } }
      },
      "additionalProperties": true
    },
    "timelineSemester": {
      "type": "object",
      "required": ["semester", "mandatory_highlights", "career_stage"],
      "properties": {
        "semester": { "type": "integer", "minimum": 1, "maximum": 8 },
        "mandatory_highlights": { "$ref": "#/$defs/stringArray" },
        "career_stage": { "type": "string" }
      },
      "additionalProperties": true
    },
    "careerAction": {
      "type": "object",
      "required": ["action_id", "title", "description", "career_ids", "career_center_resources"],
      "properties": {
        "action_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "career_ids": { "$ref": "#/$defs/stringArray" },
        "career_center_resources": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["resource_id", "title", "direct_url"],
      "properties": {
        "resource_id": { "type": "string" },
        "title": { "type": "string" },
        "direct_url": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    },
    "gameEventOption": {
      "type": "object",
      "required": ["id", "title", "effects"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "effects": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": true
    },
    "gameEvent": {
      "type": "object",
      "required": ["event_id", "title", "description", "options"],
      "properties": {
        "event_id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gameEventOption" } }
      },
      "additionalProperties": true
    },
    "recommendedElective": {
      "type": "object",
      "required": ["group_id", "discipline_id", "priority", "reason"],
      "properties": {
        "group_id": { "type": "string" },
        "discipline_id": { "type": "string" },
        "priority": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": true
    },
    "careerRoute": {
      "type": "object",
      "required": ["career_id", "key_skills", "core_disciplines", "recommended_electives", "timeline_highlights", "career_actions"],
      "properties": {
        "career_id": { "type": "string" },
        "key_skills": { "$ref": "#/$defs/stringArray" },
        "core_disciplines": { "$ref": "#/$defs/stringArray" },
        "recommended_electives": { "type": "array", "items": { "$ref": "#/$defs/recommendedElective" } },
        "timeline_highlights": {
          "type": "object",
          "properties": {
            "year_1": { "$ref": "#/$defs/stringArray" },
            "year_2": { "$ref": "#/$defs/stringArray" },
            "year_3": { "$ref": "#/$defs/stringArray" },
            "year_4": { "$ref": "#/$defs/stringArray" }
          },
          "additionalProperties": { "$ref": "#/$defs/stringArray" }
        },
        "career_actions": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": true
    }
  }
}
