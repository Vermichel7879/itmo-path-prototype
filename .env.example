# Supabase Transaction pooler. Required by the server-side runtime.
TRANSACTION_DATABASE_URL=

# Migration-only connections. Prefer Direct; use Session only where supported.
DIRECT_DATABASE_URL=
DATABASE_URL=

# Admin authentication. Use independent long random values; never commit .env files.
ADMIN_SECURITY_SECRET=
INITIAL_ADMIN_LOGIN=
INITIAL_ADMIN_PASSWORD=
